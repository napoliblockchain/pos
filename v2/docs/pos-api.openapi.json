{
  "openapi": "3.1.0",
  "info": {
    "title": "Napay POS operator API - DRAFT, not implemented",
    "version": "0.1.0-draft",
    "description": "User-approved flow: POS email/password form with server-to-server Napay verification, token only in POS server session. Wire protocol and service authentication remain proposals requiring backend review. No payment endpoints, direct browser API access, SIN or wallet keys. Manager force-unlock remains in Napay backoffice with its own authorization and CSRF."
  },
  "x-contract-status": "draft-awaiting-backend-review",
  "x-login-flow": "pos-form-server-to-server-approved",
  "servers": [
    {
      "url": "https://napay.local/api/pos/v1",
      "description": "Proposed logical origin, not an available API. Container DNS/CA routing requires agreement."
    }
  ],
  "security": [
    {
      "PosClient": [],
      "OperatorSession": []
    }
  ],
  "paths": {
    "/sessions": {
      "post": {
        "operationId": "createOperatorSession",
        "summary": "Email login, no SIN. Reject disabled accounts and duplicate/ambiguous email with generic invalid credentials.",
        "security": [
          {
            "PosClient": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Login"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "New scoped operator session. Token stays in POS server-side session, never browser JSON/localStorage.",
            "headers": {
              "Cache-Control": {
                "description": "Always no-store.",
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Session"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        }
      },
      "delete": {
        "operationId": "logoutOperator",
        "summary": "Revoke this operator session and close only openings owned by this session, atomically. Never release another operator opening.",
        "responses": {
          "204": {
            "description": "Session revoked.",
            "headers": {
              "Cache-Control": {
                "description": "Always no-store.",
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/terminals": {
      "get": {
        "operationId": "listAuthorizedTerminals",
        "summary": "Filter explicit user-store grants before pagination. Empty grants return an empty list. Labels are store_name - name; no SIN or wallet address.",
        "parameters": [
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Authorized terminals only; cursor must preserve caller scope.",
            "headers": {
              "Cache-Control": {
                "description": "Always no-store.",
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Catalog"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/terminals/{terminal_id}/openings": {
      "post": {
        "operationId": "openTerminal",
        "summary": "Atomically acquire one opening. Fresh second acquisition is 409, including same user/device. Idempotent replay returns the original opening without creating or replacing anything.",
        "parameters": [
          {
            "name": "terminal_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Scope to caller session, operation and payload. Reusing key with a different payload is 409."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OpenRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Replay of the same idempotent acquisition.",
            "headers": {
              "Cache-Control": {
                "description": "Always no-store.",
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Opening"
                }
              }
            }
          },
          "201": {
            "description": "Opening acquired.",
            "headers": {
              "Cache-Control": {
                "description": "Always no-store.",
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Opening"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/openings/{opening_id}": {
      "get": {
        "operationId": "checkOpening",
        "summary": "Verify current session ownership, live grants, terminal state and current generation. Out-of-scope resources return 404; own invalidated opening returns 409. GET never acquires or resumes a lock.",
        "parameters": [
          {
            "name": "opening_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Opening remains valid.",
            "headers": {
              "Cache-Control": {
                "description": "Always no-store.",
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Opening"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/openings/{opening_id}/heartbeat": {
      "post": {
        "operationId": "heartbeatOpening",
        "summary": "Validate ownership and fencing proof before recording contact. Never resurrect revoked openings. Missing heartbeat does not automatically unlock the POS.",
        "parameters": [
          {
            "name": "opening_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OpeningProof"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Contact recorded; lock remains exclusive.",
            "headers": {
              "Cache-Control": {
                "description": "Always no-store.",
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/openings/{opening_id}/release": {
      "post": {
        "operationId": "releaseOpening",
        "summary": "Normal close by the owning operator session only, using current fencing proof. This is not manager force-unlock.",
        "parameters": [
          {
            "name": "opening_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OpeningProof"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Own opening closed.",
            "headers": {
              "Cache-Control": {
                "description": "Always no-store.",
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "PosClient": {
        "type": "apiKey",
        "in": "header",
        "name": "X-POS-Client-Key",
        "description": "PROPOSED application authentication, rotated and stored only in private backend env. Not user authorization. API key versus mTLS must be agreed with backend agent within the approved server-to-server login flow."
      },
      "OperatorSession": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "opaque",
        "description": "PROPOSED revocable scoped session, unrelated to Napay browser cookies; held only by POS server, never in URLs."
      }
    },
    "schemas": {
      "Login": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "writeOnly": true
          }
        }
      },
      "Session": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "access_token",
          "token_type",
          "expires_at",
          "operator"
        ],
        "properties": {
          "access_token": {
            "type": "string",
            "minLength": 32,
            "maxLength": 512,
            "writeOnly": false
          },
          "token_type": {
            "type": "string",
            "const": "Bearer"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "operator": {
            "$ref": "#/components/schemas/Operator"
          }
        }
      },
      "Operator": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "display_name"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "display_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        }
      },
      "Terminal": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "store_name",
          "name",
          "availability"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "store_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "availability": {
            "type": "string",
            "enum": [
              "available",
              "in_use"
            ]
          }
        }
      },
      "Catalog": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "items",
          "next_cursor"
        ],
        "properties": {
          "items": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "$ref": "#/components/schemas/Terminal"
            }
          },
          "next_cursor": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 512
          }
        }
      },
      "OpenRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "instance_id"
        ],
        "properties": {
          "instance_id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "Opening": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "terminal_id",
          "instance_id",
          "generation",
          "state"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "terminal_id": {
            "type": "string",
            "format": "uuid"
          },
          "instance_id": {
            "type": "string",
            "format": "uuid"
          },
          "generation": {
            "type": "string",
            "pattern": "^[1-9][0-9]{0,19}$"
          },
          "state": {
            "type": "string",
            "const": "active"
          }
        }
      },
      "OpeningProof": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "instance_id",
          "generation"
        ],
        "properties": {
          "instance_id": {
            "type": "string",
            "format": "uuid"
          },
          "generation": {
            "type": "string",
            "pattern": "^[1-9][0-9]{0,19}$"
          }
        }
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "invalid_credentials",
                  "unauthenticated",
                  "not_allowed",
                  "not_found",
                  "terminal_in_use",
                  "opening_invalid",
                  "idempotency_conflict",
                  "validation_failed",
                  "rate_limited",
                  "backend_unavailable"
                ]
              },
              "message": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              }
            }
          }
        }
      }
    },
    "responses": {
      "Error": {
        "description": "Generic public error. No stack trace, SQL, password, token, SIN, wallet or identity of the current terminal holder. 429 also requires Retry-After.",
        "headers": {
          "Cache-Control": {
            "description": "Always no-store.",
            "schema": {
              "type": "string",
              "const": "no-store"
            }
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    }
  }
}
