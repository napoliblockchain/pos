# Supply through Docker env_file; never generate production keys during image build.
COOKIE_VALIDATION_KEY=
POS_MODE=preview
POS_LABEL=Napay POS
NAPAY_API_BASE_URL=https://napay.local/api/pos/v1
# Runtime copies of externally mounted Docker secrets, never raw key values.
NAPAY_POS_CLIENT_KEY_FILE=/run/pos-secrets/client-key
NAPAY_CA_FILE=/run/pos-secrets/ca.crt
