# Copy outside application repositories; owner-only directory 0700 and file 0600.
# Plain KEY=value, no quotes, interpolation or inline comments. Never put raw client keys here.
POS_MODE=production
COOKIE_VALIDATION_KEY=
NAPAY_API_BASE_URL=https://napay.example.invalid/api/pos/v1
POS_TRUSTED_PROXIES=10.250.0.0/24
POS_LABEL=Napay POS
NAPAY_CLIENT_KEY_SOURCE=/srv/private/pos/client-key
POS_RUNTIME_DIR=/srv/private/pos/runtime
POS_GATEWAY_NETWORK=napay-production-edge
POS_COMPOSE_PROJECT=pos-v2-production
POS_DEPLOY_WAIT_SECONDS=180
# Optional private CA; omit or leave empty for the image's system CA store.
NAPAY_CA_SOURCE=
